# Dependencies
node_modules/

# Cypress perf reports (generated on every run — do not commit)
cypress/perf-reports/

# Integration test artefacts (generated by the plugin's own Cypress tests)
cypress/integration-baselines/
cypress/integration-reports/

# Baseline files are intentionally committed, but if you want to ignore
# feature-branch baselines and only commit main.json, uncomment:
# cypress/perf-baselines/
# !cypress/perf-baselines/main.json

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# npm pack dry-run artefacts
*.tgz
